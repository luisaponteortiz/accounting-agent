+        with patch.object(sys,'argv',[str(path),str(ROOT)]):spec.loader.exec_module(module)
+        self.addCleanup(module.TMP.cleanup)
+        return module,next(fn for identifier,_,_,fn in module.PROBES if identifier=='RT14b')
+
