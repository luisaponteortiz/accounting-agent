+def attempt(fn, *args, **kwargs):
+    """Return ('ok', result) or ('refused', http-style status, message)."""
+    try:
+        return ('ok', fn(*args, **kwargs))
+    except ControlError as exc:
+        return ('refused', exc.status, str(exc))
+
+
+def show(label, result):
