+ ("os_.intake(PREP, packet('void-d1', gone + [stmt(rows[2:])])); run(os_, 'card_preparation')", "os_.intake(PREP, packet('void-d1', gone + [stmt(rows[2:])])); run(os_, 'card_preparation'); accept_statement_revision(os_,CARD+':D2')"),
