+def probe(pid, title):
+    def deco(fn):
+        print('\n### %s %s' % (pid, title))
+        try:
+            verdict = fn()
+        except Exception as exc:
+            verdict = 'ERROR'
+            print('  PROBE ERROR:', type(exc).__name__, exc)
+            traceback.print_exc(limit=3)
+        print('  VERDICT:', verdict)
+        RESULTS.append((pid, verdict, title))
+    return deco
