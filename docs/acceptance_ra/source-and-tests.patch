+REV2 = human('rv-reviewer-2', 'reviewer')
+REV3 = human('rv-reviewer-3', 'reviewer')
+REV4 = human('rv-reviewer-4', 'reviewer')
+DISP = human('rv-dispositioner', 'reviewer')
