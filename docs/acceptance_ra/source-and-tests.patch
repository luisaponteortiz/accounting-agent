+        pkt = packet('sup-' + variant, [new, rc('A1X', '2026-12-02', '40.00')] + other + [stmt(other, DEC, opening='100.00')])
+        os_.intake(PREP2, pkt); replay = os_.intake(PREP2, pkt)
+        run(os_, 'card_preparation', '2026-12', PREP2)
