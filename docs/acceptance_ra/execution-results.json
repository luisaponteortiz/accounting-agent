  "tickets": [
    {
      "id": "RA-01",
      "priority": "P1",
      "title": "A second supersession step releases a charge that is quarantined behind a locked period",
      "developer_status": "PASS_WITH_DISCLOSED_CURRENT_SETUP",
      "independent_acceptance": "PENDING",
      "acceptance_assertions": [
        "Probe X01 reports OK: while November is locked, December has no governing artifact for A1Y.",
        "state.source_exceptions lists A1X, A1Y and both receipts with SOURCE_MOVED_FROM_LOCKED_PERIOD; export.source_move_history has a blocked row for each.",
        "After reopen and re-preparation: November has no governing A1, December has exactly one governing item for the charge (A1Y) carrying SOURCE_TRANSITION_REQUIRES_REVIEW, and A1X is not a governing item anywhere.",
        "Probes A01, RN02 and RN02b are unchanged."
      ],
      "regression_methods": [
        "test_RA01_entire_chain_and_receipts_remain_blocked_until_reopen",
        "test_RA01_supersession_cycle_is_refused_without_mutation"
      ],
      "independent_probe": "X01"
    },
    {
      "id": "RA-02",
      "priority": "P2",
      "title": "The author of a rule is dropped from the item lineage when a colleague re-proposes the same rule without the optional supersedes link",
      "developer_status": "PASS_WITH_DISCLOSED_CURRENT_SETUP",
      "independent_acceptance": "PENDING",
      "acceptance_assertions": [
        "Probe A10 reports OK: the unlinked cosmetic re-proposal leaves the author of version 1 refused with 403.",
        "The different-category case in A10 is still allowed, and RN05b, RN04, RN05 are unchanged."
      ],
      "regression_methods": [
        "test_RA02_unlinked_rule_identity_preserves_semantic_authors_without_unrelated_scope",
        "test_RA02_unlinked_identical_receipt_policy_retains_author"
      ],
      "independent_probe": "A10"
    },
    {
      "id": "RA-03",
      "priority": "P2",
      "title": "Replacing a receipt under a new key avoids the revised-evidence hold",
      "developer_status": "PASS_WITH_DISCLOSED_CURRENT_SETUP",
      "independent_acceptance": "PENDING",
      "acceptance_assertions": [
        "Probe X12k reports OK: after the replacement the item carries EVIDENCE_REVISED_REQUIRES_REVIEW and evidence_revisions names receipt-A1 version 1 and the amount change.",
        "The supplier of either receipt cannot accept; a granted non-supplier can; probe A12 is unchanged.",
        "A second receipt added for a charge whose first receipt is unchanged is not reported as a revision (it remains a multiple-receipt question)."
      ],
      "regression_methods": [
        "test_RA03_replacement_key_discloses_old_receipt_and_keeps_both_suppliers_independent",
        "test_RA03_additional_receipt_is_multiple_support_until_the_original_is_withdrawn"
      ],
      "independent_probe": "X12k"
    },
    {
      "id": "RA-04",
      "priority": "P2",
      "title": "A statement re-supplied to agree with the population is neither held nor disclosed as revised",
