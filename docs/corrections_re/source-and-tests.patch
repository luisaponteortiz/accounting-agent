+        binding=db.execute('SELECT b.* FROM source_periods b JOIN snapshots s ON s.id=b.snapshot_id WHERE s.scope=? AND s.kind=? AND s.source_key=? ORDER BY b.id DESC LIMIT 1',(actor.scope,kind,key)).fetchone()
